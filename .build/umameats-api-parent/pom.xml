<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.umameats</groupId>
    <artifactId>umameats-api-parent</artifactId>
    <version>2.0.1</version>
    <packaging>pom</packaging>
    <name>UmaMeats API Parent</name>
    <description>Shared parent POM for UmaMeats Spring Boot APIs</description>

    <properties>
        <java.version>26</java.version>
        <maven.compiler.proc>full</maven.compiler.proc>
        <aws.java.sdk.version>2.51.0</aws.java.sdk.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.java.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.umameats</groupId>
                <artifactId>umameats-messaging</artifactId>
                <version>2.1.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/algorithmikk/umameats-api-parent</url>
        </repository>
    </distributionManagement>
</project>
