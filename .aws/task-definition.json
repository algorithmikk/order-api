{
   "family": "order-api",
   "containerDefinitions": [
       {
           "name": "order-api",
           "image": "${AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com/order-api:latest",
           "cpu": 256,
           "memory": 512,
           "portMappings": [
               {
                   "containerPort": 8080,
                   "hostPort": 8080,
                   "protocol": "tcp"
               }
           ],
           "essential": true,
           "environment": [
               {
                   "name": "KAFKA_BOOTSTRAP_SERVERS",
                   "value": "${KAFKA_BOOTSTRAP_SERVERS}"
               },
               {
                   "name": "TWILIO_CONTENT_TEMPLATE_SID",
                   "value": "${TWILIO_CONTENT_TEMPLATE_SID}"
               }
           ],
           "secrets": [
               {
                   "name": "GOOGLE_MAPS_API_KEY",
                   "valueFrom": "arn:aws:secretsmanager:us-east-1:${AWS_ACCOUNT_ID}:secret:prod/google-maps-api-key-ShB7nc"
               }
           ],
           "logConfiguration": {
               "logDriver": "awslogs",
               "options": {
                   "awslogs-group": "/ecs/order-api",
                   "awslogs-region": "us-east-1",
                   "awslogs-stream-prefix": "ecs"
               }
           }
       }
   ],
   "networkMode": "awsvpc",
   "requiresCompatibilities": [
       "FARGATE"
   ],
   "cpu": "256",
   "memory": "512",
   "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/ecsTaskExecutionRole",
   "taskRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/ecsTaskRole"
}
